{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://junkim100.github.io/frontier-benchmarks/schema/definitions.schema.json",
  "title": "Frontier Benchmark Observatory canonical definitions",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "definitions_version", "definitions"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0.0"},
    "definitions_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "definitions": {
      "type": "array",
      "minItems": 8,
      "items": {"$ref": "#/$defs/definition"}
    }
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"},
    "definition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "version", "algorithm", "description", "examples", "cautions"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "label": {"type": "string", "minLength": 1},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "algorithm": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "comparable_scope", "omission_count"],
          "properties": {
            "kind": {"enum": ["present_without_prior_occurrence", "present_after_immediately_prior_presence", "present_after_prior_omission", "absent_after_prior_presence", "consecutive_reviewed_omissions", "coverage_or_comparability_uncertain", "evidence_gap_requires_exclusion"]},
            "comparable_scope": {"const": "same_lineage_modality_and_use_class"},
            "omission_count": {"type": "integer", "minimum": 0, "maximum": 2}
          }
        },
        "description": {"type": "string", "minLength": 1},
        "examples": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "cautions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
